#!/bin/sh

MIN_COVERAGE=25
TRACE_DIR="/tmp/famchain_traces"
export TRACE_DIR

# Run the exact same tests as runtests, but with tracing enabled
./.ci/runtests || exit 1

# ══════════════════════════════════════════════════════════════════════════════
# Coverage reports
# ══════════════════════════════════════════════════════════════════════════════

RC=0

echo ""
echo "══════════════════════════════════════════════════════════════════"
echo " Bootloader Coverage"
echo "══════════════════════════════════════════════════════════════════"
cat "$TRACE_DIR"/0*.log > "$TRACE_DIR/merged_boot.log"
python3 tools/coverage.py tmp/famchain.bin "$TRACE_DIR/merged_boot.log" --min $MIN_COVERAGE || RC=1

# Auto-discover all unit test traces and report coverage for each
for trace in "$TRACE_DIR"/test_*.log; do
	name=$(basename "$trace" .log)
	bin="tmp/${name}.bin"
	if [ -f "$bin" ] && [ -f "$trace" ]; then
		echo ""
		echo "══════════════════════════════════════════════════════════════════"
		echo " Coverage: $name"
		echo "══════════════════════════════════════════════════════════════════"
		python3 tools/coverage.py "$bin" "$trace" --min $MIN_COVERAGE || RC=1
	fi
done

exit $RC
