#!/bin/sh
# Run integration tests with instruction tracing, then generate coverage report.

MIN_COVERAGE=25
TRACE_DIR="/tmp/famchain_traces"
export TRACE_DIR

mkdir -p "$TRACE_DIR"
rm -f "$TRACE_DIR"/*.log

# Patch run_qemu to add tracing — re-run the integration tests with traces
./.ci/runtests "$@" || exit 1

echo ""
echo "=================================================================="
echo " Bootloader Coverage"
echo "=================================================================="

cat "$TRACE_DIR"/*.log > "$TRACE_DIR/merged.log" 2>/dev/null
python3 tools/coverage.py tmp/famchain.bin "$TRACE_DIR/merged.log" --min $MIN_COVERAGE
