#!/bin/sh
# Integration tests for the famchain bootloader.

if [ "$CI" = "true" ]; then
	sudo apt-get update
	sudo apt install -y gcc-riscv64-unknown-elf qemu-system-misc
fi

PREFIX="${RISCV_PREFIX:-riscv64-unknown-elf}"
AS="${PREFIX}-as"
OBJCOPY="${PREFIX}-objcopy"

if ! command -v "$AS" >/dev/null 2>&1; then
	echo "Error: $AS not found. Set RISCV_PREFIX to your toolchain prefix."
	exit 1
fi

MARCH="-march=rv32i_zicsr -mabi=ilp32"

PASS=0
FAIL=0

mkdir -p tmp

# ── Helpers ──

build_node() {
	$AS $MARCH -I inc -o tmp/node.o "$1" || exit 1
	$OBJCOPY -O binary tmp/node.o tmp/node.bin || exit 1
}

build_bootloader() {
	./tools/gen_bin_config.py tmp/node.bin tmp
	$AS $MARCH -I tmp -o tmp/famchain.o src/famchain.S || exit 1
	$OBJCOPY -O binary tmp/famchain.o tmp/famchain.bin || exit 1
}

reset_disk() {
	dd if=/dev/zero of=./tmp/disk.img bs=512 count=16 conv=notrunc 2>/dev/null
}

start_server() {
	./tools/server.py &
	SERVER_PID=$!
	sleep 0.2
}

stop_server() {
	kill $SERVER_PID 2>/dev/null || true
	sleep 0.2
}

run_qemu() {
	# $1 = host list string, $2 = timeout (default 10), $3 = smp (default 2), $4 = trace name
	local hosts="$1"
	local tmout="${2:-10}"
	local smp="${3:-2}"
	local trace_flags=""
	if [ -n "$TRACE_DIR" ] && [ -n "$4" ]; then
		trace_flags="-d in_asm -D $TRACE_DIR/$4.log"
	fi
	(echo "$hosts"; printf '\004') | timeout "$tmout" qemu-system-riscv32 \
		-machine virt \
		-nographic \
		-bios none \
		-smp "$smp" \
		$trace_flags \
		-device loader,file=./tmp/famchain.bin,addr=0x80000000 \
		-netdev user,id=net0,hostfwd=tcp::2222-:22 \
		-drive file=./tmp/disk.img,if=none,format=raw,id=dr0 \
		-device virtio-blk-device,drive=dr0,bus=virtio-mmio-bus.0 \
		-device virtio-net-device,netdev=net0,bus=virtio-mmio-bus.1 \
		>/dev/null 2>/dev/null
}

pass() {
	echo "  PASS: $1"
	PASS=$((PASS + 1))
}

fail() {
	echo "  FAIL: $1"
	FAIL=$((FAIL + 1))
}

# ══════════════════════════════════════════════════════════════════════════════
# Test 1: Basic download + disk cache + seed list + hart wake
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 1: Basic download + cache + seeds + hart wake ==="
build_node test/node.S
build_bootloader
reset_disk
start_server

if run_qemu "127.0.0.1:3737" 10 2 "01_download"; then
	pass "download + execute"
else
	fail "download + execute"
fi

stop_server

if run_qemu "127.0.0.1:3737" 10 2 "02_cache"; then
	pass "disk cache hit"
else
	fail "disk cache hit"
fi

# ══════════════════════════════════════════════════════════════════════════════
# Test 2: Multi-chunk download (3+ chunks)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 2: Multi-chunk download (3 chunks) ==="
build_node test/node_large.S
build_bootloader
reset_disk
start_server

if run_qemu "127.0.0.1:3737" 10 2 "03_multi"; then
	pass "multi-chunk download"
else
	fail "multi-chunk download"
fi

stop_server

if run_qemu "127.0.0.1:3737" 10 2 "04_multi_cache"; then
	pass "multi-chunk disk cache"
else
	fail "multi-chunk disk cache"
fi

# ══════════════════════════════════════════════════════════════════════════════
# Test 3: Multi-host round-robin (dead host first, fallback to live)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 3: Multi-host failover ==="
build_node test/node.S
build_bootloader
reset_disk
start_server

if run_qemu "192.0.2.1:9999 127.0.0.1:3737" 20 2 "05_failover"; then
	pass "multi-host failover"
else
	fail "multi-host failover"
fi

stop_server

# ══════════════════════════════════════════════════════════════════════════════
# Test 4: Hash mismatch rejection (corrupt binary -> H!)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 4: Hash mismatch rejection ==="
build_node test/node.S
# Build bootloader WITHOUT correct hash (skip gen_bin_config)
$AS $MARCH -I inc -o tmp/famchain.o src/famchain.S || exit 1
$OBJCOPY -O binary tmp/famchain.o tmp/famchain.bin || exit 1
reset_disk
start_server

trace_flags=""
if [ -n "$TRACE_DIR" ]; then
	trace_flags="-d in_asm -D $TRACE_DIR/06_hash_reject.log"
fi
output=$({ echo "127.0.0.1:3737"; printf '\004'; } | timeout 3 qemu-system-riscv32 \
	-machine virt -nographic -bios none -smp 1 \
	$trace_flags \
	-device loader,file=./tmp/famchain.bin,addr=0x80000000 \
	-netdev user,id=net0,hostfwd=tcp::2222-:22 \
	-drive file=./tmp/disk.img,if=none,format=raw,id=dr0 \
	-device virtio-blk-device,drive=dr0,bus=virtio-mmio-bus.0 \
	-device virtio-net-device,netdev=net0,bus=virtio-mmio-bus.1 \
	2>/dev/null || true)
if echo "$output" | grep -q "H!"; then
	pass "hash mismatch rejection"
else
	fail "hash mismatch rejection (expected H!, got: $output)"
fi

stop_server

# ══════════════════════════════════════════════════════════════════════════════
# Test 5: Disk corruption recovery (valid cache corrupted -> re-downloads)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 5: Disk corruption recovery ==="
build_node test/node.S
build_bootloader
reset_disk
start_server

if run_qemu "127.0.0.1:3737" 10 2 "07_populate"; then
	pass "populate cache"
else
	fail "populate cache"
	stop_server
	exit 1
fi

printf '\xff\xff\xff\xff' | dd of=./tmp/disk.img bs=1 count=4 conv=notrunc 2>/dev/null

if run_qemu "127.0.0.1:3737" 10 2 "08_corrupt"; then
	pass "disk corruption recovery"
else
	fail "disk corruption recovery"
fi

stop_server

# ══════════════════════════════════════════════════════════════════════════════
# Test 6: EOT immediately after port (no trailing newline)
# Exercises parse_eot -> store_port path
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 6: EOT after port (no newline) ==="
build_node test/node.S
build_bootloader
reset_disk
start_server

trace_flags=""
if [ -n "$TRACE_DIR" ]; then
	trace_flags="-d in_asm -D $TRACE_DIR/09_eot_port.log"
fi
# printf avoids the trailing newline that echo adds
output=$(printf '127.0.0.1:3737\004' | timeout 10 qemu-system-riscv32 \
	-machine virt -nographic -bios none -smp 2 \
	$trace_flags \
	-device loader,file=./tmp/famchain.bin,addr=0x80000000 \
	-netdev user,id=net0,hostfwd=tcp::2222-:22 \
	-drive file=./tmp/disk.img,if=none,format=raw,id=dr0 \
	-device virtio-blk-device,drive=dr0,bus=virtio-mmio-bus.0 \
	-device virtio-net-device,netdev=net0,bus=virtio-mmio-bus.1 \
	2>/dev/null)
rc=$?
if [ "$rc" -eq 0 ] && echo "$output" | grep -q "WOK"; then
	pass "EOT after port"
else
	fail "EOT after port (rc=$rc, output=$output)"
fi

stop_server

# ══════════════════════════════════════════════════════════════════════════════
# Test 7: Empty seed list (no hosts → F! after disk hash fail)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 7: Empty seed list ==="
build_node test/node.S
build_bootloader
reset_disk

trace_flags=""
if [ -n "$TRACE_DIR" ]; then
	trace_flags="-d in_asm -D $TRACE_DIR/10_empty_seeds.log"
fi
output=$(printf '\004' | timeout 5 qemu-system-riscv32 \
	-machine virt -nographic -bios none -smp 1 \
	$trace_flags \
	-device loader,file=./tmp/famchain.bin,addr=0x80000000 \
	-netdev user,id=net0,hostfwd=tcp::2222-:22 \
	-drive file=./tmp/disk.img,if=none,format=raw,id=dr0 \
	-device virtio-blk-device,drive=dr0,bus=virtio-mmio-bus.0 \
	-device virtio-net-device,netdev=net0,bus=virtio-mmio-bus.1 \
	2>/dev/null || true)
if echo "$output" | grep -q "F!"; then
	pass "empty seed list"
else
	fail "empty seed list (expected F!, got: $output)"
fi

# ══════════════════════════════════════════════════════════════════════════════
# Summary
# ══════════════════════════════════════════════════════════════════════════════
echo ""
echo "=================================="
echo "Results: $PASS passed, $FAIL failed"
echo "=================================="

if [ "$FAIL" -ne 0 ]; then
	exit 1
fi
