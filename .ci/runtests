#!/bin/sh

if [ "$CI" = "true" ]; then
	sudo apt-get update
	sudo apt install -y gcc-riscv64-unknown-elf qemu-system-misc
fi

AS="riscv64-unknown-elf-as"
OBJCOPY="riscv64-unknown-elf-objcopy"
MARCH="-march=rv32i_zicsr -mabi=ilp32"

PASS=0
FAIL=0

# Coverage mode: set TRACE_DIR to enable QEMU instruction tracing
QEMU_TRACE_FLAGS=""
if [ -n "$TRACE_DIR" ]; then
	mkdir -p "$TRACE_DIR"
	rm -f "$TRACE_DIR"/*.log
fi

# ── Auto-generate library includes from inc/*.inc ──
# lib_includes.inc: .include directives (macros.inc first, then all libraries)
# lib_defines.inc:  DEFINE_* macro calls for each library
echo '.include "macros.inc"' > tmp/lib_includes.inc
: > tmp/lib_defines.inc
for f in inc/*.inc; do
	name=$(basename "$f")
	case "$name" in macros.inc|bin_config.inc) continue ;; esac
	echo ".include \"$name\"" >> tmp/lib_includes.inc
	macro=$(grep '\.macro DEFINE_' "$f" | sed 's/.*\.macro //' | head -1)
	if [ -n "$macro" ]; then
		echo "$macro" >> tmp/lib_defines.inc
	fi
done

# ── helpers ──

build_node() {
	$AS $MARCH -I inc -o tmp/node.o "$1" || exit 1
	$OBJCOPY -O binary tmp/node.o tmp/node.bin || exit 1
}

build_bootloader() {
	./tools/gen_bin_config.py tmp/node.bin tmp
	$AS $MARCH -I tmp -o tmp/famchain.o src/famchain.S || exit 1
	$OBJCOPY -O binary tmp/famchain.o tmp/famchain.bin || exit 1
}

reset_disk() {
	dd if=/dev/zero of=./tmp/disk.img bs=512 count=16 conv=notrunc 2>/dev/null
}

start_server() {
	./tools/server.py &
	SERVER_PID=$!
	sleep 0.2
}

stop_server() {
	kill $SERVER_PID 2>/dev/null || true
	sleep 0.2
}

run_qemu() {
	# $1 = host list string, $2 = timeout (default 10), $3 = smp (default 2), $4 = trace name
	local hosts="$1"
	local tmout="${2:-10}"
	local smp="${3:-2}"
	local trace_name="$4"
	local trace_flags=""
	if [ -n "$TRACE_DIR" ] && [ -n "$trace_name" ]; then
		trace_flags="-d in_asm -D $TRACE_DIR/$trace_name.log"
	fi
	(echo "$hosts"; printf '\004') | timeout "$tmout" qemu-system-riscv32 \
		-machine virt \
		-nographic \
		-bios none \
		-smp "$smp" \
		$trace_flags \
		-device loader,file=./tmp/famchain.bin,addr=0x80000000 \
		-netdev user,id=net0,hostfwd=tcp::2222-:22 \
		-drive file=./tmp/disk.img,if=none,format=raw,id=dr0 \
		-device virtio-blk-device,drive=dr0,bus=virtio-mmio-bus.0 \
		-device virtio-net-device,netdev=net0,bus=virtio-mmio-bus.1 \
		>/dev/null 2>/dev/null
}

run_unit_test() {
	# $1 = test name, $2 = source file, $3 = timeout (default 10), $4 = extra qemu flags
	echo "=== Unit: $1 ==="
	$AS $MARCH -I inc -I tmp -o "tmp/$1.o" "$2" || { fail "$1 (build)"; return; }
	$OBJCOPY -O binary "tmp/$1.o" "tmp/$1.bin" || { fail "$1 (objcopy)"; return; }
	local trace_flags=""
	if [ -n "$TRACE_DIR" ]; then
		trace_flags="-d in_asm -D $TRACE_DIR/$1.log"
	fi
	local output
	output=$(timeout "${3:-10}" qemu-system-riscv32 \
		-machine virt -nographic -bios none -smp 1 \
		$trace_flags $4 \
		-device loader,file="tmp/$1.bin",addr=0x80000000 \
		</dev/null 2>/dev/null)
	local rc=$?
	echo "$output"
	if [ "$rc" -eq 0 ]; then
		# Count individual PASS/FAIL from binary output
		local p=$(echo "$output" | grep -c "PASS")
		local f=$(echo "$output" | grep -c "FAIL")
		PASS=$((PASS + p))
		FAIL=$((FAIL + f))
	else
		fail "$1"
	fi
}

pass() {
	echo "  PASS: $1"
	PASS=$((PASS + 1))
}

fail() {
	echo "  FAIL: $1"
	FAIL=$((FAIL + 1))
}

# ══════════════════════════════════════════════════════════════════════════════
# Unit Tests
# ══════════════════════════════════════════════════════════════════════════════

# Generate STARK test proof if missing
if [ ! -f tmp/test_proof.bin ]; then
	python3 tools/stark_prover.py tmp/test_proof.bin
fi

if [ ! -f tmp/test_disk.img ]; then
	dd if=/dev/zero of=tmp/test_disk.img bs=1M count=32 2>/dev/null
fi
QEMU_DISK="-m 256M -drive file=tmp/test_disk.img,if=none,format=raw,id=dr0 -device virtio-blk-device,drive=dr0,bus=virtio-mmio-bus.0"
run_unit_test "test_all" "test/test_all.S" 300 "$QEMU_DISK"

# ══════════════════════════════════════════════════════════════════════════════
# Integration Tests (bootloader + network + disk)
# ══════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
# Test 1: Basic download + disk cache + seed list + hart wake
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 1: Basic download + cache + seeds + hart wake ==="
build_node test/node.S
build_bootloader
reset_disk
start_server

if run_qemu "127.0.0.1:3737" 10 2 "01_download"; then
	pass "download + execute"
else
	fail "download + execute"
fi

stop_server

if run_qemu "127.0.0.1:3737" 10 2 "02_cache_hit"; then
	pass "disk cache hit"
else
	fail "disk cache hit"
fi

# ══════════════════════════════════════════════════════════════════════════════
# Test 2: Multi-chunk download (3+ chunks)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 2: Multi-chunk download (3 chunks) ==="
build_node test/node_large.S
build_bootloader
reset_disk
start_server

if run_qemu "127.0.0.1:3737" 10 2 "03_multi_chunk"; then
	pass "multi-chunk download"
else
	fail "multi-chunk download"
fi

stop_server

if run_qemu "127.0.0.1:3737" 10 2 "04_multi_cache"; then
	pass "multi-chunk disk cache"
else
	fail "multi-chunk disk cache"
fi

# ══════════════════════════════════════════════════════════════════════════════
# Test 3: Multi-host round-robin (dead host first, fallback to live)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 3: Multi-host failover ==="
build_node test/node.S
build_bootloader
reset_disk
start_server

if run_qemu "192.0.2.1:9999 127.0.0.1:3737" 20 2 "05_failover"; then
	pass "multi-host failover"
else
	fail "multi-host failover"
fi

stop_server

# ══════════════════════════════════════════════════════════════════════════════
# Test 4: Hash mismatch rejection (corrupt binary → H!)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 4: Hash mismatch rejection ==="
build_node test/node.S
$AS $MARCH -I inc -o tmp/famchain.o src/famchain.S || exit 1
$OBJCOPY -O binary tmp/famchain.o tmp/famchain.bin || exit 1
reset_disk
start_server

trace_flags=""
if [ -n "$TRACE_DIR" ]; then
	trace_flags="-d in_asm -D $TRACE_DIR/06_hash_reject.log"
fi
output=$({ echo "127.0.0.1:3737"; printf '\004'; } | timeout 3 qemu-system-riscv32 \
	-machine virt -nographic -bios none -smp 1 \
	$trace_flags \
	-device loader,file=./tmp/famchain.bin,addr=0x80000000 \
	-netdev user,id=net0,hostfwd=tcp::2222-:22 \
	-drive file=./tmp/disk.img,if=none,format=raw,id=dr0 \
	-device virtio-blk-device,drive=dr0,bus=virtio-mmio-bus.0 \
	-device virtio-net-device,netdev=net0,bus=virtio-mmio-bus.1 \
	2>/dev/null || true)
if echo "$output" | grep -q "H!"; then
	pass "hash mismatch rejection"
else
	fail "hash mismatch rejection (expected H!, got: $output)"
fi

stop_server

# ══════════════════════════════════════════════════════════════════════════════
# Test 5: Disk corruption recovery (valid cache corrupted → re-downloads)
# ══════════════════════════════════════════════════════════════════════════════
echo "=== Test 5: Disk corruption recovery ==="
build_node test/node.S
build_bootloader
reset_disk
start_server

if run_qemu "127.0.0.1:3737" 10 2 "07_populate"; then
	pass "populate cache"
else
	fail "populate cache"
	stop_server
	exit 1
fi

printf '\xff\xff\xff\xff' | dd of=./tmp/disk.img bs=1 count=4 conv=notrunc 2>/dev/null

if run_qemu "127.0.0.1:3737" 10 2 "08_corrupt_recover"; then
	pass "disk corruption recovery"
else
	fail "disk corruption recovery"
fi

stop_server

# ══════════════════════════════════════════════════════════════════════════════
# Summary
# ══════════════════════════════════════════════════════════════════════════════
echo ""
echo "══════════════════════════════════"
echo "Results: $PASS passed, $FAIL failed"
echo "══════════════════════════════════"

if [ "$FAIL" -ne 0 ]; then
	exit 1
fi
