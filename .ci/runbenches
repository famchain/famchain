#!/bin/sh
# Run benchmarks. Not part of CI pass/fail — informational only.

if [ "$CI" = "true" ]; then
	sudo apt-get update
	sudo apt install -y gcc-riscv64-unknown-elf qemu-system-misc
fi

AS="riscv64-unknown-elf-as"
OBJCOPY="riscv64-unknown-elf-objcopy"
MARCH_I="-march=rv32i_zicsr -mabi=ilp32"
MARCH_IM="-march=rv32im_zicsr -mabi=ilp32"
MARCH="$MARCH_I"

run_bench() {
	# $1 = name, $2 = source file, $3 = timeout (default 120), $4 = extra qemu flags, $5 = march override, $6 = extra as flags
	local march="${5:-$MARCH}"
	echo "══════════════════════════════════"
	echo " $1"
	echo "══════════════════════════════════"
	$AS $march -I inc -I tmp $6 -o "tmp/$1.o" "$2" || { echo "BUILD FAILED"; return 1; }
	$OBJCOPY -O binary "tmp/$1.o" "tmp/$1.bin" || { echo "OBJCOPY FAILED"; return 1; }
	timeout "${3:-120}" qemu-system-riscv32 \
		-machine virt -nographic -bios none -smp 1 \
		$4 \
		-device loader,file="tmp/$1.bin",addr=0x80000000 \
		</dev/null 2>/dev/null
	echo ""
}

# Auto-generate library includes
mkdir -p tmp
echo '.include "macros.inc"' > tmp/lib_includes.inc
: > tmp/lib_defines.inc
for f in inc/*.inc; do
	name=$(basename "$f")
	case "$name" in macros.inc|bin_config.inc) continue ;; esac
	echo ".include \"$name\"" >> tmp/lib_includes.inc
	macro=$(grep '\.macro DEFINE_' "$f" | sed 's/.*\.macro //' | head -1)
	if [ -n "$macro" ]; then
		echo "$macro" >> tmp/lib_defines.inc
	fi
done

run_bench "bench_wots" "bench/bench_wots.S"
run_bench "bench_compress" "bench/bench_compress.S" 120 "-m 256M"
run_bench "bench_stark_rv32i" "bench/bench_stark.S" 300 "-m 256M"
run_bench "bench_stark_rv32im" "bench/bench_stark.S" 300 "-m 256M" "$MARCH_IM" "--defsym HAVE_M_ASM=1"
