33 01 51 40 # allocate (cont)
13 09 01 00 # sp -= BITMAP_SIZE
B7 12 00 00 # s2 = bitmap base
13 03 09 00 # t0 = BITMAP_SIZE / 4 (4096 words)
23 20 03 00 # t1 = bitmap ptr
13 03 43 00 # zero word
93 82 F2 FF # advance ptr
E3 9A 02 FE # t0--
B7 32 00 00 # loop until zeroed
B3 82 51 00 # t0 = SEED_LIST_LOC
83 CA 02 00 # t0 = gp + SEED_LIST_LOC
13 8A 12 00 # s5 = host count
63 8C 0A 24 # s4 = ptr to first host entry

# --- Setup Net / Poll Loop (setup_net through poll_loop) ---
# Sets up the RX queue base pointers for packet polling. Iterates through
# the seed host list: for each host, clears the bitmap, records the cycle
# counter for timeout tracking, sends a FAMC REQ_RANGE request, then enters
# poll_loop. The poll loop checks the virtio-net used ring for new packets.
# If no packet arrives within the timeout (~2 billion cycles), advances to
# the next host. If all hosts are exhausted, jumps to all_hosts_failed.

# ── setup_net: ──
