# =============================================================================
# famchain.fam0 - RISC-V 32-bit Network Bootloader
#
# A bare-metal bootloader for RISC-V 32-bit (RV32I) running on QEMU virt
# machine. Initializes virtio-net and virtio-blk devices, reads a binary
# from disk, verifies it with BLAKE2s, and executes it. If the disk cache
# is empty or corrupt, downloads the binary from seed hosts over UDP using
# the FAMC protocol, verifies the hash, and jumps to the loaded program.
# Seed hosts are provided as an ASCII "ip:port" list via UART at boot.
# =============================================================================

# --- Entry Point (_start) ---
# Parks secondary harts (non-primary cores go to secondary_park), sets up
# the global pointer (gp) page-aligned to the data section, initializes the
# stack pointer (sp) at gp + 4 MiB, and zeros the memory region from gp
# to LOAD_LOC to ensure a clean state before device initialization.

# ── _start: ──
73 22 40 F1 # read hart ID
E3 14 02 74 # secondary harts -> park
97 11 00 00 # LOAD_ADDRESS gp, data
93 81 01 06 # gp = data label (PC-relative)
B7 12 00 00 # t0 = 4095
93 82 F2 FF # gp += 4095 (for alignment)
B3 81 51 00 # gp = gp + t0
B7 F2 FF FF # t0 = -4096 (0xFFFFF000)
B3 F1 51 00 # gp &= -4096 (page-align)
B7 02 40 00 # t0 = STACK_OFFSET (4 MiB)
33 81 51 00 # sp = gp + 4 MiB
93 83 01 00 # t2 = gp (start of zero region)
37 6E 00 00 # t3 hi = LOAD_LOC
13 0E 2E 21 # t3 = LOAD_LOC offset
33 8E C1 01 # t3 = gp + LOAD_LOC (end of zero region)
23 A0 03 00 # zero word at t2
93 83 43 00 # t2 += 4
E3 EC C3 FF # loop until t2 >= t3

# --- Initialize virtio-net (INIT_NET) ---
# Performs the virtio legacy MMIO handshake for the network device at
# VIRTIO_NET_BASE (0x10002000): reset, ACK, DRIVER, negotiate features,
# set FEATURES_OK, configure guest page size, set up RX queue (queue 0)
# and TX queue (queue 1) each with depth 1, then set DRIVER_OK to bring
# the device live. Posts the first RX descriptor (1536-byte write buffer)
# and kicks queue 0 so the device can begin receiving packets.

37 24 00 10 # s0 = VIRTIO_NET_BASE (0x10002000)
23 28 04 06 # reset device (VIO_STATUS = 0)
93 02 10 00 # t0 = 1
23 28 54 06 # VIO_STATUS = ACK
93 02 30 00 # t0 = 3
23 28 54 06 # VIO_STATUS = ACK + DRIVER
03 23 04 01 # read device features
23 20 64 02 # accept all features
03 23 04 07 # read VIO_STATUS
13 63 83 00 # set FEATURES_OK bit
23 28 64 06 # write VIO_STATUS
B7 12 00 00 # t0 = 4096
23 24 54 02 # set guest page size
23 28 04 02 # select queue 0 (RX)
93 02 10 00 # t0 = 1
23 2C 54 02 # QueueNum = 1
B7 12 00 00 # t0 = 4096
23 2E 54 02 # QueueAlign = 4096
93 02 00 00 # t0 = RX_QUEUE_DATA_OFFSET (0)
B3 83 51 00 # t2 = gp + 0
93 D3 C3 00 # PFN = address >> 12
23 20 74 04 # set RX QueuePFN
93 02 10 00 # t0 = 1
23 28 54 02 # select queue 1 (TX)
23 2C 54 02 # QueueNum = 1
B7 12 00 00 # t0 = 4096
23 2E 54 02 # QueueAlign = 4096
B7 22 00 00 # t0 = TX_QUEUE_DATA_OFFSET (8192)
B3 83 51 00 # t2 = gp + 8192
93 D3 C3 00 # PFN = address >> 12
23 20 74 04 # set TX QueuePFN
03 23 04 07 # read VIO_STATUS
13 63 43 00 # set DRIVER_OK bit
23 28 64 06 # write VIO_STATUS (device live)
13 8E 01 00 # t3 = gp (RX queue base)
93 0E 0E 20 # t4 = RX buffer at queue_base+512
23 20 DE 01 # desc[0].addr = buffer
23 22 0E 00 # desc[0].addr high = 0
93 0E 00 60 # desc[0].len = 1536
23 24 DE 01 # desc[0].len (cont)
93 0E 20 00 # desc[0].flags = WRITE
23 16 DE 01 # desc[0].next = 0
23 17 0E 00 # avail.flags = 0
23 18 0E 00 # avail.idx = 1
93 0E 10 00 # avail.idx (cont)
23 19 DE 01 # avail.ring[0] = 0
23 1A 0E 00 # fence w,w (memory barrier)
0F 00 10 01 # kick queue 0 (RX)
23 28 04 04 # t5 = UART_BASE

# --- UART Seed List Parser (parse_loop through parse_done) ---
# Reads an ASCII list of "ip:port" entries from UART, terminated by EOT
# (0x04). Parses dotted-decimal IP addresses and port numbers, storing
# each host as a 6-byte binary entry (4 bytes IP + 2 bytes port big-endian)
# at gp+SEED_LIST_LOC. The first byte at SEED_LIST_LOC holds the host count.
# Supports up to MAX_HOSTS (16) entries.

37 0F 00 10 # t2 hi = SEED_LIST_LOC + 1
B7 33 00 00 # t2 = offset for seed write ptr
93 83 13 00 # t2 = gp + SEED_LIST_LOC + 1 (skip count)
B3 83 71 00 # s5 = 0 (host count)
93 0A 00 00 # s6 = 0 (accumulator)
13 0B 00 00 # t3 = 0 (field index: 0-3=IP, 4=port)
13 0E 00 00 # li	t3,0

# ── parse_loop: ──
83 42 5F 00 # read UART LSR
93 F2 12 00 # check data ready bit
E3 8C 02 FE # loop until byte available
83 42 0F 00 # read character from UART
13 03 40 00 # t1 = 4 (EOT)
63 80 62 0A # if char == EOT -> parse_eot
13 03 00 03 # t1 = 48 ('0')
63 E2 62 02 # if char < '0' -> parse_sep
13 03 A0 03 # t1 = 58 ('9'+1)
63 FE 62 00 # if char >= ':' -> parse_sep
93 82 02 FD # digit = char - '0'
13 13 3B 00 # acc * 8
93 1E 1B 00 # acc * 2
33 0B D3 01 # acc * 10
33 0B 5B 00 # acc = acc * 10 + digit
6F F0 5F FC # loop back to parse_loop

# ── parse_sep: ──
13 03 E0 02 # t1 = '.'
63 84 62 02 # if char == '.' -> parse_dot
13 03 A0 03 # t1 = ':'
63 86 62 02 # if char == ':' -> parse_colon
13 03 40 00 # t1 = 4 (port field index)
63 16 6E 00 # if not in port mode -> reset
EF 0F C0 03 # store port (via t6 leaf call)
93 83 63 00 # advance write ptr by HOST_ENTRY_SZ (6)

# ── parse_reset: ──
13 0B 00 00 # reset accumulator
13 0E 00 00 # reset field index
6F F0 9F F9 # loop back to parse_loop

# ── parse_dot: ──
13 03 30 00 # t1 = 3
E3 78 6E F8 # if field >= 3 -> ignore extra dots
6F 00 C0 00 # -> store_octet

# ── parse_colon: ──
13 03 30 00 # t1 = 3
E3 12 6E F8 # if field != 3 -> ignore

# ── store_octet: ──
B3 8E C3 01 # t4 = write_ptr + field_index
23 80 6E 01 # store octet byte
13 0E 1E 00 # field_index++
13 0B 00 00 # reset accumulator
6F F0 1F F7 # loop back to parse_loop

# ── store_port: ──
13 03 00 01 # MAX_HOSTS check (16)
63 F4 6A 02 # if count >= MAX_HOSTS -> done
13 53 8B 00 # port high byte = acc >> 8
23 82 63 00 # store port high
13 73 FB 0F # port low byte = acc & 0xFF
A3 82 63 00 # store port low
93 8A 1A 00 # host count++
67 80 0F 00 # return via t6

# ── parse_eot: ──
13 03 40 00 # t1 = 4
63 14 6E 00 # if not in port mode -> done
EF FF 9F FD # store final port

# ── parse_done: ──
B7 32 00 00 # t0 = SEED_LIST_LOC (12288)
B3 82 51 00 # t0 = gp + SEED_LIST_LOC
23 80 52 01 # store host count byte

# --- Initialize virtio-blk (INIT_DISK) ---
# Performs the virtio legacy MMIO handshake for the block device at
# VIRTIO_DISK_BASE (0x10001000): verifies the magic number and device ID,
# resets, negotiates features, sets FEATURES_OK, configures queue 0 with
# depth 16, and brings the device live with DRIVER_OK. Prepares the
# destination pointer (s2) at LOAD_LOC and sector counter for the boot read.

# ── INIT_DISK: ──
B7 12 00 10 # t0 = VIRTIO_DISK_BASE (0x10001000)
03 A3 02 00 # read VIO_MAGIC
B7 73 72 74 # t2 = expected magic ('virt')
93 83 63 97 # t2 (cont)
E3 18 73 52 # if magic wrong -> error
03 A3 82 00 # read VIO_DEVICE_ID
93 03 20 00 # t2 = 2 (block device)
E3 12 73 52 # if not block device -> error
23 A8 02 06 # reset device
13 03 10 00 # t1 = 1
23 A8 62 06 # VIO_STATUS = ACK
03 A3 02 07 # read VIO_STATUS
13 63 23 00 # set DRIVER bit
23 A8 62 06 # write VIO_STATUS
03 A3 02 01 # read device features
23 A0 02 02 # accept none
03 A3 02 07 # read VIO_STATUS
13 63 83 00 # set FEATURES_OK
23 A8 62 06 # write VIO_STATUS
03 A3 02 07 # read VIO_STATUS
93 73 83 00 # check FEATURES_OK
E3 86 03 4E # if not accepted -> error
37 13 00 00 # t1 = 4096
23 A4 62 02 # set guest page size
23 A8 02 02 # select queue 0
13 03 00 01 # t1 = 16 (queue depth)
23 AC 62 02 # QueueNum = 16
37 13 00 00 # t1 = 4096
23 AE 62 02 # QueueAlign = 4096
13 83 01 00 # t1 = gp
37 5F 00 00 # t5 = VIRT_DESCRIPTOR_TABLE (20480)
33 03 E3 01 # t1 = gp + descriptor table
13 53 C3 00 # PFN = address >> 12
23 A0 62 04 # set disk QueuePFN
03 A3 02 07 # read VIO_STATUS
13 63 43 00 # set DRIVER_OK
23 A8 62 06 # write VIO_STATUS (disk live)
37 69 00 00 # s2 hi = LOAD_LOC
13 09 29 21 # s2 = LOAD_LOC offset
33 09 39 00 # s2 = gp + LOAD_LOC (dest ptr)
93 09 00 00 # s3 = 0 (sector counter)
93 0A 80 22 # s5 = BIN_SIZE (552)

# --- Boot Read (start_block) ---
# Reads the binary image from disk sector by sector (512 bytes each) into
# memory at LOAD_LOC. Calls disk_read for each sector, copies bytes from
# the disk data buffer to the destination, and decrements the remaining
# byte count until BIN_SIZE bytes have been loaded.

# ── start_block: ──
13 85 09 00 # a0 = sector number
93 89 19 00 # s3++ (avail_idx)
93 85 09 00 # a1 = avail_idx
EF 00 00 08 # jal disk_read
B7 42 00 00 # t0 = DISK_DATA_BUFFER (16384)
33 84 51 00 # s0 = gp + disk buffer
93 04 04 20 # s1 = end of 512-byte buffer
03 45 04 00 # load byte from disk buffer
23 00 A9 00 # store byte to LOAD_LOC region
93 8A FA FF # s5-- (bytes remaining)
63 8A 0A 00 # if done -> check hash
13 09 19 00 # advance dest ptr
13 04 14 00 # advance src ptr
E3 14 94 FE # loop until end of sector
6F F0 9F FC # next sector

# --- Hash Verification ---
# Computes a BLAKE2s hash of the loaded binary at LOAD_LOC (BIN_SIZE bytes),
# then calls check_hash to compare the 32-byte digest against the expected
# hash stored in the data section. If the hash matches, execution continues
# to the disk hit path. If it mismatches, branches to hash_mismatch to
# attempt a network download.

37 64 00 00 # s0 hi = LOAD_LOC
13 04 24 21 # s0 = LOAD_LOC offset
33 04 34 00 # s0 = gp + LOAD_LOC
13 01 01 FE # allocate 32 bytes for hash output
13 05 04 00 # a0 = input ptr
93 05 80 22 # a1 = BIN_SIZE (552)
13 06 01 00 # a2 = output ptr (sp)
EF 00 80 4C # jal blake2s
13 05 01 00 # a0 = hash output ptr
EF 00 00 11 # jal check_hash
13 01 01 02 # free hash output
E3 1E 05 18 # if mismatch -> hash_mismatch (download)

# --- Disk Hit Path ---
# Hash matched: the disk cache is valid. Passes the seed list pointer
# (gp + SEED_LIST_LOC) in a0 so the loaded program knows where to find
# the host list, then jumps to the loaded binary at LOAD_LOC.

37 35 00 00 # a0 hi = SEED_LIST_LOC
33 05 35 00 # a0 = gp + SEED_LIST_LOC (pass to program)
B7 62 00 00 # t0 hi = LOAD_LOC
93 82 22 21 # t0 = LOAD_LOC offset
B3 82 32 00 # t0 = gp + LOAD_LOC
67 80 02 00 # jump to loaded program
73 00 50 10 # wfi (halt)
6F F0 DF FF # infinite loop

# --- disk_read ---
# Leaf function: reads one 512-byte sector from virtio-blk.
# Sets up a 3-descriptor chain: desc[0] = virtio-blk header (sector number,
# type=read), desc[1] = 512-byte data buffer (write), desc[2] = 1-byte
# status (write). Posts to the available ring, kicks queue 0, then polls
# the status byte until the device signals completion (status != 0xFF).
# Args: a0 = sector number, a1 = avail_idx.

# ── disk_read: ──
37 5F 00 00 # t5 = VIRT_DESCRIPTOR_TABLE
33 83 E1 01 # t1 = gp + descriptor table
37 6E 00 00 # t3 = VIRT_DISK_STATUS
13 0E 0E 20 # t3 = gp + disk status
33 8E C1 01 # t2 = disk header (status + 2)
93 03 2E 00 # type = 0 (read)
23 A0 03 00 # sector number
23 A4 A3 00 # desc[0].addr = header
23 20 73 00 # desc[0].addr high = 0
23 22 03 00 # desc[0].len = 16
93 0E 00 01 # desc[0].flags = NEXT
23 24 D3 01 # desc[0].next = 1
93 0E 10 00 # desc[0].next (cont)
23 16 D3 01 # t5 = DISK_DATA_BUFFER
23 17 D3 01 # t5 = gp + buffer
37 4F 00 00 # desc[1].addr = buffer
33 8F E1 01 # desc[1].addr high = 0
23 28 E3 01 # desc[1].len = 512
23 2A 03 00 # desc[1].len (cont)
93 0E 00 20 # desc[1].flags = NEXT|WRITE (3)
23 2C D3 01 # desc[1].next = 2
93 0E 30 00 # desc[1].next (cont)
23 1E D3 01 # desc[2].addr = status
93 0E 20 00 # desc[2].addr high = 0
23 1F D3 01 # desc[2].len = 1
23 20 C3 03 # desc[2].flags = WRITE (2)
23 22 03 02 # desc[2].flags (cont)
93 0E 10 00 # desc[2].next = 0
23 24 D3 03 # t4 = avail ring base (+256)
93 0E 20 00 # avail.ring[0] = 0
23 16 D3 03 # t5 = 0xFF (sentinel)
23 17 03 02 # set status sentinel
93 0E 03 10 # avail.idx = a1
23 92 0E 00 # fence w,w
13 0F F0 0F # t5 = VIRTIO_DISK_BASE
23 00 EE 01 # kick queue 0
23 91 BE 00 # t5 = 0xFF
0F 00 10 01 # read status byte
37 1F 00 10 # wait until status != 0xFF
23 28 0F 04 # fence r,r
13 0F F0 0F # ret
83 4E 0E 00 # lbu	t4,0(t3)
E3 8E EE FF # beq	t4,t5,0x3cc
0F 00 20 02 # fence	r,r
67 80 00 00 # ret

# --- write_guest_mac ---
# Leaf function: writes the 6-byte guest MAC address (52:54:00:12:34:56)
# to the buffer pointed to by a0. Used when building Ethernet frames for
# ARP replies and outgoing UDP packets.

# ── write_guest_mac: ──
93 02 20 05 # store GUEST_MAC_0 (0x52)
23 00 55 00 # store (cont)
93 02 40 05 # store GUEST_MAC_1 (0x54)
A3 00 55 00 # store (cont)
23 01 05 00 # store GUEST_MAC_2 (0x00)
93 02 20 01 # store GUEST_MAC_3 (0x12)
A3 01 55 00 # store (cont)
93 02 40 03 # store GUEST_MAC_4 (0x34)
23 02 55 00 # store (cont)
93 02 60 05 # store GUEST_MAC_5 (0x56)
A3 02 55 00 # store (cont)
67 80 00 00 # ret

# --- check_hash ---
# Leaf function: compares a 32-byte computed hash (pointed to by a0)
# against the expected_hash in the data section, word by word (8 words).
# Returns a0 = 0 if all words match, a0 = 1 on first mismatch.

# ── check_hash: ──
17 13 00 00 # LOAD_ADDRESS t1, expected_hash
13 03 83 C3 # t1 = expected_hash ptr
93 03 80 00 # t2 = 8 (word count)
83 22 05 00 # load computed hash word
03 2E 03 00 # load expected hash word
63 9E C2 01 # if mismatch -> return 1
13 05 45 00 # advance computed ptr
13 03 43 00 # advance expected ptr
93 83 F3 FF # t2--
E3 94 03 FE # loop
13 05 00 00 # a0 = 0 (match)
67 80 00 00 # ret (match)
13 05 10 00 # a0 = 1 (mismatch)
67 80 00 00 # ret (mismatch)

# --- tx_kick ---
# Leaf function: posts a single TX descriptor and kicks virtio-net queue 1.
# Writes the buffer address (a0) and length (a1) into TX desc[0], bumps
# the available ring index, issues a fence, and writes to the queue notify
# register to trigger transmission.

# ── tx_kick: ──
B7 23 00 00 # t2 = TX_QUEUE_DATA_OFFSET
B3 83 71 00 # t2 = gp + TX queue
23 A0 A3 00 # desc[0].addr = a0 (buffer)
23 A2 03 00 # desc[0].addr high = 0
23 A4 B3 00 # desc[0].len = a1 (length)
23 96 03 00 # desc[0].flags = 0
23 97 03 00 # desc[0].next = 0
23 98 03 00 # avail.flags = 0
83 D2 23 01 # read avail.idx
93 82 12 00 # avail.idx++
23 99 53 00 # write avail.idx
23 9A 03 00 # avail.ring[0] = 0
0F 00 10 01 # fence w,w
B7 22 00 10 # t0 = VIRTIO_NET_BASE
13 03 10 00 # t1 = 1 (TX queue number)
23 A8 62 04 # kick queue 1 (TX)
67 80 00 00 # ret

# --- write_byte ---
# Leaf function: writes one byte (in a0) to the UART transmit register.
# Polls the UART LSR until the TX holding register is empty, then stores
# the byte.

# ── write_byte: ──
37 03 00 10 # t1 = UART_BASE
83 43 53 00 # read UART LSR
93 F3 03 02 # check TX ready
E3 8A 03 FE # wait if busy
23 00 A3 00 # write byte
67 80 00 00 # ret

# --- b2s_g ---
# BLAKE2s G mixing function (RFC 7693 section 3.1).
# Performs the quarter-round mixing: two add-xor-rotate pairs with rotation
# constants 16, 12, 8, and 7. Operates on four state words (va, vb, vc, vd)
# and two message words (mx, my) passed in registers.

# ── b2s_g: ──
33 05 B5 00 # va += vb
33 05 E5 00 # va += mx
B3 C6 A6 00 # vd ^= va
93 D2 06 01 # ROTR(vd, 16) part 1
13 93 06 01 # ROTR(vd, 16) part 2
B3 E6 62 00 # vd = rotated
33 06 D6 00 # vc += vd
B3 C5 C5 00 # vb ^= vc
93 D2 C5 00 # ROTR(vb, 12) part 1
13 93 45 01 # ROTR(vb, 12) part 2
B3 E5 62 00 # vb = rotated
33 05 B5 00 # va += vb
33 05 F5 00 # va += my
B3 C6 A6 00 # vd ^= va
93 D2 86 00 # ROTR(vd, 8) part 1
13 93 86 01 # ROTR(vd, 8) part 2
B3 E6 62 00 # vd = rotated
33 06 D6 00 # vc += vd
B3 C5 C5 00 # vb ^= vc
93 D2 75 00 # ROTR(vb, 7) part 1
13 93 95 01 # ROTR(vb, 7) part 2
B3 E5 62 00 # vb = rotated
67 80 00 00 # ret

# --- b2s_compress ---
# BLAKE2s compression function (RFC 7693 section 3.2).
# Initializes the 16-word working vector v[0..15] from the hash state h[0..7]
# and IV[0..7], XORing IV[4..6] with the counter and finalization flag.
# Runs 10 rounds of 8 G-calls each, using the sigma permutation table to
# select message word pairs. After all rounds, folds v[0..15] back into h
# via h[i] ^= v[i] ^ v[i+8].

# ── b2s_compress: ──
13 01 01 FE # SETUP s0-s6 (save to stack)
23 20 11 00 # sw ra
23 22 81 00 # sw s0
23 24 91 00 # sw s1
23 26 21 01 # sw s2
23 28 31 01 # sw s3
23 2A 41 01 # sw s4
23 2C 51 01 # sw s5
23 2E 61 01 # sw s6
13 04 05 00 # s0 = h_ptr (a0)
93 84 05 00 # s1 = m_ptr (a1)
13 01 01 FC # allocate v[0..15] on stack (64 bytes)
13 09 01 00 # s2 = v_base (sp)
83 22 04 00 # lw	t0,0(s0)
23 20 59 00 # sw	t0,0(s2)
83 22 44 00 # lw	t0,4(s0)
23 22 59 00 # sw	t0,4(s2)
83 22 84 00 # lw	t0,8(s0)
23 24 59 00 # sw	t0,8(s2)
83 22 C4 00 # lw	t0,12(s0)
23 26 59 00 # sw	t0,12(s2)
83 22 04 01 # lw	t0,16(s0)
23 28 59 00 # sw	t0,16(s2)
83 22 44 01 # lw	t0,20(s0)
23 2A 59 00 # sw	t0,20(s2)
83 22 84 01 # lw	t0,24(s0)
23 2C 59 00 # sw	t0,24(s2)
83 22 C4 01 # lw	t0,28(s0)
23 2E 59 00 # sw	t0,28(s2)
17 13 00 00 # auipc	t1,0x1
13 03 43 9F # addi	t1,t1,-1548
83 22 03 00 # lw	t0,0(t1)
23 20 59 02 # sw	t0,32(s2)
83 22 43 00 # lw	t0,4(t1)
23 22 59 02 # sw	t0,36(s2)
83 22 83 00 # lw	t0,8(t1)
23 24 59 02 # sw	t0,40(s2)
83 22 C3 00 # lw	t0,12(t1)
23 26 59 02 # sw	t0,44(s2)
83 22 03 01 # lw	t0,16(t1)
B3 C2 C2 00 # xor	t0,t0,a2
23 28 59 02 # sw	t0,48(s2)
83 22 43 01 # lw	t0,20(t1)
B3 C2 D2 00 # xor	t0,t0,a3
23 2A 59 02 # sw	t0,52(s2)
83 22 83 01 # lw	t0,24(t1)
B3 C2 E2 00 # xor	t0,t0,a4
23 2C 59 02 # sw	t0,56(s2)
83 22 C3 01 # lw	t0,28(t1)
23 2E 59 02 # sw	t0,60(s2)
97 19 00 00 # auipc	s3,0x1
93 89 09 9C # addi	s3,s3,-1600
17 1A 00 00 # auipc	s4,0x1
13 0A 8A A5 # addi	s4,s4,-1448
93 0A 00 00 # li	s5,0

# ── _b2s_round: ──
93 02 A0 00 # li	t0,10
63 DA 5A 0E # bge	s5,t0,0x6d0
13 0B 00 00 # li	s6,0

# ── _b2s_gcall: ──
93 02 80 00 # li	t0,8
63 50 5B 0E # bge	s6,t0,0x6c8
93 12 2B 00 # slli	t0,s6,0x2
B3 82 42 01 # add	t0,t0,s4
03 CE 02 00 # lbu	t3,0(t0)
83 CE 12 00 # lbu	t4,1(t0)
03 CF 22 00 # lbu	t5,2(t0)
83 CF 32 00 # lbu	t6,3(t0)
93 92 4A 00 # slli	t0,s5,0x4
13 13 1B 00 # slli	t1,s6,0x1
B3 82 62 00 # add	t0,t0,t1
B3 82 32 01 # add	t0,t0,s3
03 C3 02 00 # lbu	t1,0(t0)
83 C3 12 00 # lbu	t2,1(t0)
13 13 23 00 # slli	t1,t1,0x2
33 03 93 00 # add	t1,t1,s1
03 27 03 00 # lw	a4,0(t1)
93 93 23 00 # slli	t2,t2,0x2
B3 83 93 00 # add	t2,t2,s1
83 A7 03 00 # lw	a5,0(t2)
93 12 2E 00 # slli	t0,t3,0x2
